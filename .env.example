# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# BRSAPI_KEY: free/paid API key from https://brsapi.ir for live gold/currency/TSETMC rates.
# Get your own key at brsapi.ir and put it in your local .env file (never commit the real
# key — .env is already gitignored). The app falls back to offline/local rates if this is
# invalid or empty.
#
# SECURITY WARNING: the app now calls BrsApi.ir directly (the Cloudflare Worker proxy was
# dropped after BrsApi returned 401 Unauthorized for requests coming from the Worker's IPs).
# That means this key IS compiled into the APK's BuildConfig and CAN be extracted by anyone
# who decompiles the app (e.g. with apktool/jadx) in a few minutes. Only use a key you're
# fine being public, and keep an eye on your brsapi.ir usage/quota for signs of abuse.
BRSAPI_KEY=YourApiKey

# PROXY_BASE_URL: no longer used (kept only so old builds referencing it don't break).
# Leave blank.

# CMC_API_KEY: CoinMarketCap API key for the crypto analysis module (Basic/free tier —
# ~10-15k call credits/month, no historical data). Get one at
# https://pro.coinmarketcap.com/signup. Same APK-exposure caveat as BRSAPI_KEY: this key
# is compiled into BuildConfig and is extractable by decompiling the APK.
CMC_API_KEY=YourCoinMarketCapApiKey
